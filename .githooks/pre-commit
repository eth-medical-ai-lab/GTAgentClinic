#!/bin/sh
# Pre-commit secret scan. `npm install` points git at this folder (core.hooksPath=.githooks, via the
# "prepare" script). It blocks the commit if a staged file looks like it contains a credential.
# See SECURITY.md. Bypass only if you are sure: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is not on PATH, so the secret scan can't run. Commit from a shell where node works." >&2
  exit 1
fi
node "$root/scripts/check-secrets.mjs" --staged || exit 1

# A second opinion from gitleaks' larger rule set, if it is installed (brew install gitleaks).
if command -v gitleaks >/dev/null 2>&1; then
  v=$(gitleaks version 2>/dev/null | sed 's/^v//')
  major=$(echo "$v" | cut -d. -f1)
  minor=$(echo "$v" | cut -d. -f2)
  if [ "${major:-0}" -gt 8 ] 2>/dev/null || { [ "${major:-0}" -eq 8 ] 2>/dev/null && [ "${minor:-0}" -ge 19 ] 2>/dev/null; }; then
    gitleaks git --staged --redact --no-banner "$root" || exit 1 # gitleaks 8.19+
  else
    gitleaks protect --staged --redact --no-banner --source "$root" || exit 1
  fi
fi
